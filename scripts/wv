#!/bin/bash
# wv — Weave CLI: In-memory graph for AI coding agents
# Fast, ephemeral task/context tracking via SQLite in tmpfs
# See: docs/WEAVE.md
#
# Modular architecture (v1.2):
#   lib/wv-config.sh   — configuration, hot zone, colors
#   lib/wv-db.sh       — database init, migrations, queries
#   lib/wv-validate.sh — ID generation, validation, edge types
#   lib/wv-cache.sh    — context cache management
#   cmd/wv-cmd-core.sh — init, add, done, ready, list, show, status, update, quick, ship
#   cmd/wv-cmd-graph.sh— block, link, resolve, related, edges, path, context
#   cmd/wv-cmd-data.sh — batch, plan, enrich-topology, sync, load, compact, prune, unarchive, clean-ghosts, commit-refs, learnings, refs, import, search, reindex, trails (alias: breadcrumbs)
#   cmd/wv-cmd-ops.sh  — doctor, recover, selftest, mcp-status, health, cache, preflight, digest, overview, session-summary, audit-pitfalls, pattern-audit, edge-types, guide, init-repo, help
#   cmd/wv-cmd-quality.sh — quality
#   cmd/wv-cmd-findings.sh — findings

set -euo pipefail

# ═══════════════════════════════════════════════════════════════════════════
# XDG-Compliant Module Resolution (v1.3)
# ═══════════════════════════════════════════════════════════════════════════
# Resolution order:
#   1. $SCRIPT_DIR/lib/ (dev mode — running from git checkout)
#   2. ~/.local/lib/weave/ (installed mode — XDG standard)
#
# This allows seamless switching between development and production.

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export WV_CLI="${WV_CLI:-$SCRIPT_DIR/wv}"
WV_LIB_DIR="${WV_LIB_DIR:-}"

_wv_append_user_tool_path() {
    local dir="$1"
    [ -d "$dir" ] || return 0
    case ":${PATH:-}:" in
        *":$dir:"*) return 0 ;;
    esac
    PATH="${PATH:+$PATH:}$dir"
}

if [ "${WV_DISABLE_USER_TOOL_PATHS:-0}" != "1" ]; then
    _wv_append_user_tool_path "$HOME/.local/bin"
    _wv_append_user_tool_path "$HOME/.cargo/bin"
    export PATH
fi

# Resolve library directory: dev (relative) or installed (XDG)
if [ -z "$WV_LIB_DIR" ]; then
    if [ -f "$SCRIPT_DIR/lib/wv-config.sh" ]; then
        # Dev mode: running from source checkout
        WV_LIB_DIR="$SCRIPT_DIR"
    elif [ -f "${HOME}/.local/lib/weave/lib/wv-config.sh" ]; then
        # Installed mode: XDG standard location
        WV_LIB_DIR="${HOME}/.local/lib/weave"
    else
        echo "wv: cannot find library modules" >&2
        echo "  Checked: $SCRIPT_DIR/lib/wv-config.sh" >&2
        echo "  Checked: ${HOME}/.local/lib/weave/lib/wv-config.sh" >&2
        exit 1
    fi
fi

# Source library modules (order matters: config first, then db needs config vars)
# wv-command-capabilities.sh is generated from contracts/command-capabilities.json
# and declares what each command touches, whether the run cache may serve it and
# how the counterweight classifies it. It is data, has no dependencies, and is
# sourced first so every module below can consult it.
source "$WV_LIB_DIR/lib/wv-command-capabilities.sh"
# wv-policy-rules.sh is generated from contracts/policy-rules-v1.json: the policy
# contract's identity and which rules can decide inside each operation.
source "$WV_LIB_DIR/lib/wv-policy-rules.sh"
# wv-graph-diff.sh: the durable table list and wv hotzone diff, no dependencies.
source "$WV_LIB_DIR/lib/wv-graph-diff.sh"
# wv hotzone diff runs before placement is resolved (wv-757de1): it is how a
# repository whose database sits in two hot zones compares the copies, and
# wv-config.sh refuses every command in exactly that state. It reads two
# databases it is given, read-only, and needs no hot zone, so it never
# reaches the refusal; every other command still does.
if [ "${1:-}" = "hotzone" ] && [ "${2:-}" = "diff" ]; then
    shift 2
    wv_graph_diff "$@"
    exit $?
fi
source "$WV_LIB_DIR/lib/wv-config.sh"
source "$WV_LIB_DIR/lib/wv-db.sh"
source "$WV_LIB_DIR/lib/wv-validate.sh"
source "$WV_LIB_DIR/lib/wv-cache.sh"
source "$WV_LIB_DIR/lib/wv-journal.sh"
source "$WV_LIB_DIR/lib/wv-attempt-journal.sh"
source "$WV_LIB_DIR/lib/wv-attribution.sh"
source "$WV_LIB_DIR/lib/wv-gh.sh"
source "$WV_LIB_DIR/lib/wv-delta.sh"
source "$WV_LIB_DIR/lib/wv-delta-catalog.sh"
source "$WV_LIB_DIR/lib/wv-checkpoint-generation.sh"
source "$WV_LIB_DIR/lib/wv-checkpoint-ci.sh"
source "$WV_LIB_DIR/lib/wv-repository-class.sh"

# Command modules load on first use (wv-13a9ae). Parsing all ten (~25k lines)
# cost ~75ms on every call whatever the command, most of it for modules the
# command never touches. Each function a module defines at column 0 gets a
# stub that sources the module -- replacing every stub it owns with the real
# definition -- and re-dispatches, in the same shell. No function is defined
# in two modules, so load order cannot change which definition wins, and no
# module has top-level state another module reads. A module first reached
# inside $(...) loads in that subshell only and again in the parent when the
# parent reaches it: slower, never different. WV_AUTOLOAD_TRACE=1 reports
# each load. WV_AUTOLOAD=0 sources every module up front, as before.
_wv_autoload() {  # _wv_autoload <module> — source cmd/wv-cmd-<module>.sh once per shell
    local __wv_al_flag="_WV_CMD_LOADED_$1"
    [ -n "${!__wv_al_flag:-}" ] && return 0
    printf -v "$__wv_al_flag" '%s' 1
    [ -n "${WV_AUTOLOAD_TRACE:-}" ] && echo "wv autoload: $1 (subshell ${BASH_SUBSHELL})" >&2
    # shellcheck source=/dev/null
    source "$WV_LIB_DIR/cmd/wv-cmd-$1.sh"
}
_wv_autoload_call() {  # stub body: _wv_autoload_call <module> <function> [args...]
    local __wv_al_mod="$1" __wv_al_fn="$2"
    shift 2
    _wv_autoload "$__wv_al_mod"
    # A column-0 "name() {" inside a heredoc is not a definition: after the
    # load it is still this stub. Drop it, so the call fails as it always did
    # (command not found) instead of recursing.
    if [[ "$(declare -f "$__wv_al_fn")" == *"_wv_autoload_call $__wv_al_mod $__wv_al_fn "* ]]; then
        unset -f "$__wv_al_fn"
    fi
    "$__wv_al_fn" "$@"
}
if [ "${WV_AUTOLOAD:-1}" = "0" ]; then
    # The same file set the stubs come from, never a typed list: a module added
    # later must not exist only on the lazy path (ultrareview #4574).
    for __wv_al_file in "$WV_LIB_DIR"/cmd/wv-cmd-*.sh; do
        __wv_al_mod="${__wv_al_file##*/wv-cmd-}"
        _wv_autoload "${__wv_al_mod%.sh}"
    done
else
    while IFS=: read -r __wv_al_file __wv_al_fn; do
        __wv_al_fn="${__wv_al_fn%()}"
        __wv_al_mod="${__wv_al_file#wv-cmd-}"; __wv_al_mod="${__wv_al_mod%.sh}"
        # Never shadow a function a library already defined.
        declare -F "$__wv_al_fn" >/dev/null && continue
        eval "$__wv_al_fn() { _wv_autoload_call $__wv_al_mod $__wv_al_fn \"\$@\"; }"
    done < <(cd "$WV_LIB_DIR/cmd" && grep -oE '^[a-zA-Z_][a-zA-Z0-9_]*\(\)' wv-cmd-*.sh)
fi
unset __wv_al_file __wv_al_fn __wv_al_mod

# ═══════════════════════════════════════════════════════════════════════════
# Main Dispatcher
# ═══════════════════════════════════════════════════════════════════════════

_resolve_first_id() {
    # Usage: _resolve_first_id <cmd_func> [args...]
    # Resolves the first non-flag argument from alias to wv-xxxx ID,
    # then calls cmd_func with the resolved args.
    local cmd_func="$1"
    shift

    local new_args=()
    local resolved_one=false
    for arg in "$@"; do
        if [ "$resolved_one" = true ] || [[ "$arg" == -* ]]; then
            new_args+=("$arg")
        elif [[ "$arg" =~ ^wv-[a-f0-9]{4,6}$ ]]; then
            new_args+=("$arg")
            resolved_one=true
        else
            local rid
            rid=$(resolve_id "$arg" 2>/dev/null)
            if [ -n "$rid" ]; then
                new_args+=("$rid")
                resolved_one=true
            else
                new_args+=("$arg")
                resolved_one=true
            fi
        fi
    done
    "$cmd_func" "${new_args[@]}"
}

_route_command_help_if_requested() {
    local cmd="$1"
    shift || true

    if [ $# -eq 0 ]; then
        return 1
    fi

    case "$1" in
        --help|-h)
            cmd_help "$cmd" "${@:2}"
            return 0
            ;;
    esac

    return 1
}

_wv_dispatch() {
    local cmd="${1:-help}"
    shift || true

    if [ "$cmd" != "help" ] && [ "$cmd" != "--help" ] && [ "$cmd" != "-h" ]; then
        if _route_command_help_if_requested "$cmd" "$@"; then
            return 0
        fi
    fi

    case "$cmd" in
        # Core commands
        init)   cmd_init "$@" ;;
        add)    cmd_add "$@" ;;
        remember) cmd_remember "$@" ;;
        memory) cmd_memory "$@" ;;
        done)       _resolve_first_id cmd_done "$@" ;;
        batch-done) cmd_batch_done "$@" ;;
        bulk-update) cmd_bulk_update "$@" ;;
        delete)     _resolve_first_id cmd_delete "$@" ;;
        work)   _resolve_first_id cmd_work "$@" ;;
        ready)  cmd_ready "$@" ;;
        list)   cmd_list "$@" ;;
        show)   _resolve_first_id cmd_show "$@" ;;
        status) cmd_status "$@" ;;
        pending-close) cmd_pending_close "$@" ;;
        update) _resolve_first_id cmd_update "$@" ;;
        touch)         _resolve_first_id cmd_touch "$@" ;;
        allowed-tools) _resolve_first_id cmd_allowed_tools "$@" ;;
        quick)  cmd_quick "$@" ;;
        ship)   _resolve_first_id cmd_ship "$@" ;;
        ship-agent) _resolve_first_id cmd_ship_agent "$@" ;;

        # Graph commands
        block)   _resolve_first_id cmd_block "$@" ;;
        link)    cmd_link "$@" ;;    # link takes two IDs; resolve inside
        unlink)  cmd_unlink "$@" ;; # unlink takes two IDs; resolve inside
        resolve) _resolve_first_id cmd_resolve "$@" ;;
        related) _resolve_first_id cmd_related "$@" ;;
        edges)   _resolve_first_id cmd_edges "$@" ;;
        path)    _resolve_first_id cmd_path "$@" ;;
        tree)    cmd_tree "$@" ;;
        context) _resolve_first_id cmd_context "$@" ;;
        impact)  cmd_impact "$@" ;;
        discover) _resolve_first_id cmd_discover "$@" ;;

        # Data commands
        batch)       cmd_batch "$@" ;;
        plan)        cmd_plan "$@" ;;
        enrich-topology) cmd_enrich_topology "$@" ;;
        sync)        cmd_sync "$@" ;;
        load)        cmd_load "$@" ;;
        compact)     cmd_compact "$@" ;;
        cutover)     cmd_cutover "$@" ;;
        prune)       cmd_prune "$@" ;;
        unarchive)   cmd_unarchive "$@" ;;
        clean-ghosts) cmd_clean_ghosts "$@" ;;
        commit-refs) cmd_commit_refs "$@" ;;
        learnings)   cmd_learnings "$@" ;;
        refs)        cmd_refs "$@" ;;
        import)      cmd_import "$@" ;;
        search)      cmd_search "$@" ;;
        reindex)     cmd_reindex "$@" ;;
        trails)      cmd_trails "$@" ;;
        breadcrumbs) cmd_trails "$@" ;;  # back-compat alias (one release) for `trails`
        
        # Ops commands
        bootstrap)       cmd_bootstrap "$@" ;;
        bootstrap-agent) cmd_bootstrap_agent "$@" ;;
        doctor)          cmd_doctor "$@" ;;
        hotzone)         cmd_hotzone "$@" ;;
        context-policy)  cmd_context_policy "$@" ;;
        test-record)     cmd_test_record "$@" ;;
        test-status)     cmd_test_status "$@" ;;
        self-update)     cmd_self_update "$@" ;;
        uninstall)       cmd_uninstall "$@" ;;
        recover)         cmd_recover "$@" ;;
        selftest)        cmd_selftest "$@" ;;
        mcp-status)      cmd_mcp_status "$@" ;;
        health)          cmd_health "$@" ;;
        cache)           cmd_cache "$@" ;;
        preflight)       _resolve_first_id cmd_preflight "$@" ;;
        digest)          cmd_digest "$@" ;;
        overview)        cmd_overview "$@" ;;
        session-summary) cmd_session_summary "$@" ;;
        audit-pitfalls)  cmd_audit_pitfalls "$@" ;;
        pattern-audit)   cmd_pattern_audit "$@" ;;
        edge-types)      cmd_edge_types "$@" ;;
        guide)           cmd_guide "$@" ;;
        repo-class)      cmd_repo_class "$@" ;;
        init-repo)       cmd_init_repo "$@" ;;
        config)          cmd_config "$@" ;;

        # Quality / analysis / query commands
        quality)            cmd_quality "$@" ;;
        findings)           cmd_findings "$@" ;;
        validate-finding)   _resolve_first_id cmd_validate_finding "$@" ;;
        analyze)            cmd_analyze "$@" ;;
        index)           cmd_index "$@" ;;
        query)           cmd_query "$@" ;;
        hook)            cmd_hook "$@" ;;
        help|--help|-h)  cmd_help "$@" ;;
        # The tag alone cannot tell two installs apart (wv-84447f). Append the
        # build when this install recorded one; the leading "wv <version>" is
        # unchanged so anything parsing the first two fields still works.
        version|--version|-v)
            _wv_build=$(wv_build_identity 2>/dev/null || true)
            if [ -n "$_wv_build" ]; then
                echo "wv $WV_VERSION (build $_wv_build)"
            else
                echo "wv $WV_VERSION"
            fi
            ;;
        
        *)
            echo -e "${RED}Unknown command: $cmd${NC}" >&2
            cmd_help
            return 1
            ;;
    esac
}

# _wv_resolve_call_source -- the call's provenance tag, before `wv hook` retags
# itself: WV_CALL_SOURCE when set, agent for a Codex or Copilot exec marker,
# otherwise shell. The precedence is explained where the call log records it.
_wv_resolve_call_source() {
    if [[ -n "${WV_CALL_SOURCE:-}" ]]; then
        printf '%s' "$WV_CALL_SOURCE"
    elif [[ -n "${CODEX_THREAD_ID:-}" || "${CODEX_CI:-}" == "1" || "${COPILOT_AGENT:-}" == "1" ]]; then
        printf agent
    else
        printf shell
    fi
}

main() {
    local cmd="${1:-help}"

    # Run cache: serve cached stdout for pure-read commands (status, ready, list)
    # Disable with WV_RUN_CACHE=0
    #
    # Classified at command level: the empty suboperation resolves the command's
    # own registry row, which dominance guarantees is never weaker than any
    # refinement beneath it. Resolving the refinement here would need the same
    # argv parse the dispatcher does not yet do; that arrives with the attempt
    # journal (wv-eb3c76), which resolves once and records what it resolved.
    if [ "${WV_RUN_CACHE:-1}" = "1" ] && _wv_cap_serve "$cmd" ""; then
        wv_run_cache_wrap _wv_dispatch "$@"
        return $?
    fi

    # Attribution queued during an E5 capture window lands in the agent's next
    # mutation-class call, after the call log recorded graph_identity_before, so
    # the graph moves inside that agent row (wv-cdafa1). A read must not apply
    # it: E5 takes any row that moved the identity as a mutation.
    if [ -n "${WV_DB:-}" ] && [ "$cmd" != "hook" ] \
        && [ "$(_wv_resolve_call_source)" = "agent" ] \
        && [ "$(_wv_cap_evidence_class "$cmd" "" 2>/dev/null)" = "mutation_attempt" ]; then
        wv_attribution_apply "$WV_DB" || true
    fi

    local rc=0
    _wv_dispatch "$@" || rc=$?

    # Invalidate run cache after successful writes
    if [ "$rc" -eq 0 ] && _wv_cap_invalidate "$cmd" ""; then
        wv_run_cache_invalidate
    fi

    return "$rc"
}

# ═══════════════════════════════════════════════════════════════════════════
# Call Instrumentation (opt-in via WV_CALL_LOG)
# ═══════════════════════════════════════════════════════════════════════════
# When WV_CALL_LOG is set, each invocation appends one JSONL line:
#   {"ts":<epoch>,"cmd":"wv <subcmd>","stdout_bytes":<n>,"stderr_bytes":<n>,"elapsed_ms":<n>,
#    "source":<src>,"call_id":<id>,"workflow_id":<id>,"trace_id":<id>,"repo_root":<path>,"exit_status":<n>,
#    "argv":[<normalized args>],"graph_identity_before":<obj>,"graph_identity_after":<obj>,
#    "policy_revision":<obj>}
#
# source values: "agent" (harness-attested direct model tool call — Claude Code via
#                settings.json env; Codex via CODEX_THREAD_ID/CODEX_CI; VS Code Copilot
#                via COPILOT_AGENT, attested below from host exec markers), "mcp"
#                (MCP-server child CLI call; kept separate so server fan-out does not
#                inflate agent stats), "shell" (unproven origin: interactive terminal or
#                an unattesting harness), "hook" (lifecycle hook), "sync" (wv sync --gh /
#                weave_gh), "test" (suite runs via run-all.sh or the pre-commit gate; under
#                WV_TEST_SUITE=1 the user's config.env cannot log them, wv-6b0f57).
# Callers set WV_CALL_SOURCE before invoking wv to tag their traffic; when unset, a Codex
# or Copilot host marker attests "agent", otherwise the default is "shell".
# Authoritative taxonomy + readiness-gate policy: docs/TELEMETRY-SOURCE-CONTRACT.md
#
# argv preserves the operation, option names, node ids, and known nested subcommands. All other
# values are replaced by "<redacted:N>" (their byte length); --option=value is represented as
# --option=<redacted:N>. This keeps free text and secrets out of the log regardless of length.
#
# graph_identity_before/after carry the composite causal identity: one SHA-256 over the ordered
# rows and their lineage, tombstones, node-file attribution, the cutover marker, the cutover
# authorization manifest and the delta-catalog frontier (see _wv_causal_identity_json). The field
# names predate the widening and are kept so existing readers keep working; what changed is that
# the value no longer stands still for a tombstone, a cutover or an arriving delta. Unlike
# connection-local PRAGMA data_version, it remains comparable across the separate wrapper
# connections used before and after a call. Falls back to the shared unavailable marker
# {"status":"unavailable","reason":...,"provenance":"wv_call_log"} when $WV_DB does not yet
# exist or sqlite3/sha256sum is missing; opening the file only in that guarded path (never blind)
# avoids sqlite3's create-on-open side effect. trace_id uses WV_TRACE_ID when supplied, otherwise
# the workflow id when present, otherwise the per-call id. policy_revision uses the same unavailable
# marker unconditionally: no live host adapter emits an authoritative policy revision yet
# (finding wv-426134), so claiming one here would be dishonest, not incomplete.
#
# Enable:  wv config enable session-analysis
# Analyse: wv analyze sessions --call-stats [--source=agent|mcp|shell|hook|sync|test]
# Zero overhead when unset.
#
# The attempt journal (scripts/lib/wv-attempt-journal.sh) shares this wrapper but not its
# contract: WV_ATTEMPT_JOURNAL names its path, WV_EVIDENCE_MODE=1 makes it mandatory and
# fail-closed, and it records call_started before dispatch so a killed call leaves an explicit
# incomplete attempt. The call log stays opt-in and best-effort either way.

# The wrapper runs for the analytics call log, for the attempt journal, or for
# evidence mode. Each surface is emitted under its own condition inside: sharing
# the wrapper is what lets both see the same call identity and the same causal
# identity, rather than each computing its own and disagreeing.
if [[ -n "${WV_CALL_LOG:-}" ]] || wv_attempt_journal_enabled; then
    # Defined once in wv-attempt-journal.sh so the call log and the journal cannot
    # escape differently; the old name stays because every printf below uses it.
    _wv_json_escape() { wv_json_escape "$@"; }
    _wv_generate_call_id() {
        if command -v uuidgen >/dev/null 2>&1; then
            uuidgen
        else
            printf 'wv-%s-%s-%s' "$(date +%s%N)" "$$" "$RANDOM"
        fi
    }
    _wv_byte_length() {
        local LC_ALL=C
        printf '%s' "${#1}"
    }
    _wv_unavailable_json() {
        printf '{"status":"unavailable","reason":"%s","provenance":"wv_call_log"}' "$(_wv_json_escape "$1")"
    }
    # ── Composite causal identity (wv-62bb60) ──────────────────────────────
    # ONE value over everything that can change what the graph causally IS: the
    # rows, the lineage stamped on them, the tombstones that record what is gone,
    # the cutover marker, the cutover authorization manifest, and the
    # delta-catalog frontier. It replaces a fingerprint over nodes, edges and
    # node_files alone -- which moved for a text edit but not for a tombstone, a
    # cutover, or an arriving delta -- and it is deliberately a single value: the
    # failure mode being closed is a growing set of ad hoc hashes, each covering
    # one input and none of them the identity.
    #
    # Components are labelled lines, and a missing component contributes an
    # explicit "absent" line rather than nothing, so a component that is absent
    # and a component that contributed the empty string cannot collide. The
    # authorization manifest has no writer yet; hashing its absence now means the
    # day it appears, the identity moves.
    _WV_CAUSAL_IDENTITY_FORMAT="weave.causal-identity.v1"
    _wv_identity_file_line() {
        local label="$1" path="$2" hash
        if [ -f "$path" ]; then
            hash=$(sha256sum -- "$path" 2>/dev/null | awk '{print $1}') || return 1
            [ -n "$hash" ] || return 1
            printf '%s\tpresent\t%s\n' "$label" "$hash"
        else
            printf '%s\tabsent\n' "$label"
        fi
    }
    _wv_identity_delta_frontier_line() {
        local root="$1" cache listing signature count digest cached_signature cached_digest cached_count
        if [ ! -d "$root" ]; then
            printf 'delta_catalog_frontier\tabsent\n'
            return 0
        fi
        # The identity covers delta CONTENT, not just which paths exist. Paths
        # alone rested on an invariant the repository states and does not enforce:
        # rewrite a delta in place and a path-only frontier stands still, which is
        # exactly the mutation a causal identity must not miss.
        #
        # Contents are not re-read on every call. The cache key is a metadata
        # signature (path, size, mtime) over the catalog; when it is unchanged the
        # stored content digest is reused. Cost is a stat walk in the common case
        # and a full rehash only when the catalog actually moved. RESIDUAL: a
        # rewrite that preserves path, size AND mtime within one hot-zone lifetime
        # reuses the cached digest. The hot zone is tmpfs, so the window closes at
        # reboot, and a Delta v2 file carries its own operation_sha256 for an
        # independent check.
        # Staging directories are excluded. They are PID-scoped scratch under the
        # deltas root that no peer can ever see, so hashing them made the
        # machine's causal identity depend on whether some earlier sync happened
        # to leave one behind -- identity drift with no graph change behind it.
        # Only published files belong in a frontier that describes what this
        # machine can hand to another.
        #
        # The hit path hashes the walk straight off the pipe and takes the file
        # count from the cache entry: holding the 800 KB listing in a shell
        # variable and piping it out twice more cost as much as the walk itself
        # (wv-78e154). The same signature means the same listing, so the same
        # count. A miss runs the full computation and stores all three.
        cache="${WV_HOT_ZONE:-${TMPDIR:-/tmp}}/delta-catalog-digest"
        if [ -r "$cache" ]; then
            read -r cached_signature cached_digest cached_count < "$cache" 2>/dev/null || true
            if [ -n "${cached_signature:-}" ] && [ -n "${cached_digest:-}" ] && [[ "${cached_count:-}" =~ ^[0-9]+$ ]]; then
                signature=$(LC_ALL=C find -P "$root" -type f -not -path '*/.staging-*' -printf '%P\t%s\t%T@\n' 2>/dev/null \
                    | LC_ALL=C sort | sha256sum | awk '{print $1}') || return 1
                if [ "$signature" = "$cached_signature" ]; then
                    printf 'delta_catalog_frontier\tpresent\t%s\t%s\n' "$cached_count" "$cached_digest"
                    return 0
                fi
            fi
        fi
        listing=$(LC_ALL=C find -P "$root" -type f -not -path '*/.staging-*' -printf '%P\t%s\t%T@\n' 2>/dev/null | LC_ALL=C sort) || return 1
        count=$(printf '%s\n' "$listing" | grep -c . || true)
        signature=$(printf '%s\n' "$listing" | sha256sum | awk '{print $1}') || return 1
        digest=$( (cd "$root" && LC_ALL=C find -P . -type f -not -path '*/.staging-*' -printf '%P\0' 2>/dev/null | LC_ALL=C sort -z | xargs -0 -r sha256sum) \
            | awk '{printf "%s\t%s\n", $2, $1}' | LC_ALL=C sort | sha256sum | awk '{print $1}') || return 1
        { mkdir -p "$(dirname "$cache")" && printf '%s %s %s\n' "$signature" "$digest" "$count" > "$cache"; } 2>/dev/null || true
        printf 'delta_catalog_frontier\tpresent\t%s\t%s\n' "$count" "$digest"
    }
    # The database key of the graph-rows cache: "<dev>:<ino> <size> <mtime_ns>
    # <ctime_ns>" of $WV_DB, or nothing while the WAL holds frames. With the WAL
    # empty the main file is the whole database, so its stat moves with every
    # committed write. ctime is in the key because no userspace call can set it:
    # a copy that restores an old mtime still moves ctime.
    _wv_identity_db_key() {
        local wal_size key
        wal_size=$(stat -c %s -- "$WV_DB-wal" 2>/dev/null || echo 0)
        [ "$wal_size" = 0 ] || return 1
        key=$(stat -c '%d:%i %s %.9Y %.9Z' -- "$WV_DB" 2>/dev/null) || return 1
        printf '%s\n' "${key//./}"
    }
    # graph_rows digest: a 4 MB dump and hash of every row on a 1700-node graph,
    # about 160 ms, paid twice per call, which made a logged wv call cost about
    # 720 ms against 100 ms unlogged (wv-78e154). The digest is reused while the
    # database file is unchanged; the value is the same bytes either way, since
    # E5 admission recomputes it from the rows and chains it across every call.
    #
    # Stored only when it cannot be stale. The key is read before and after the
    # dump and must match, so a write landing mid-dump is not cached under either
    # key. File times here are coarse (4 ms ticks on this tmpfs), so two writes
    # in one tick can share an mtime; as in git's racy-clean index, a key whose
    # ctime is not at least WV_IDENTITY_RACY_NS older than the first stat is not
    # stored, and any later write then lands on a later tick than the key holds.
    _wv_identity_graph_rows() {
        local cache key key_after cached_db cached_key cached_rows started ctime snapshot rows
        cache="${WV_HOT_ZONE:-${TMPDIR:-/tmp}}/graph-rows-digest"
        started=$(date +%s%N)
        if key=$(_wv_identity_db_key) && [ -r "$cache" ]; then
            IFS=$'\t' read -r cached_db cached_key cached_rows < "$cache" 2>/dev/null || true
            if [ "${cached_db:-}" = "$WV_DB" ] && [ "${cached_key:-}" = "$key" ] \
                && [[ "${cached_rows:-}" =~ ^[a-f0-9]{64}$ ]]; then
                printf '%s\n' "$cached_rows"
                return 0
            fi
        fi
        snapshot=$(sqlite3 -readonly "$WV_DB" 2>/dev/null <<'SQL'
BEGIN;
SELECT json_array('node', id, text, status, json(metadata), alias, created_at, updated_at,
                  lineage_actor, lineage_seq)
FROM nodes ORDER BY id;
SELECT json_array('edge', source, target, type, weight, json(context), created_at,
                  lineage_actor, lineage_seq)
FROM edges ORDER BY source, target, type;
SELECT json_array('node_file', node_id, path)
FROM node_files ORDER BY node_id, path;
SELECT json_array('tombstone', kind, id, lineage_seq, lineage_actor)
FROM tombstones ORDER BY kind, id;
COMMIT;
SQL
        ) || return 1
        rows=$(printf '%s' "$snapshot" | sha256sum | awk '{print $1}') || return 1
        [[ "$rows" =~ ^[a-f0-9]{64}$ ]] || return 1
        if [ -n "${key:-}" ] && key_after=$(_wv_identity_db_key) && [ "$key_after" = "$key" ]; then
            ctime="${key##* }"
            if [ $((started - ctime)) -ge "${WV_IDENTITY_RACY_NS:-100000000}" ]; then
                { printf '%s\t%s\t%s\n' "$WV_DB" "$key" "$rows" > "$cache.$$" \
                    && mv -f "$cache.$$" "$cache"; } 2>/dev/null || rm -f "$cache.$$" 2>/dev/null
            fi
        fi
        printf '%s\n' "$rows"
    }
    _wv_causal_identity_json() {
        local weave_dir="${WEAVE_DIR:-}"
        if [[ -z "${WV_DB:-}" || ! -f "$WV_DB" ]] \
            || ! command -v sqlite3 >/dev/null 2>&1 \
            || ! command -v sha256sum >/dev/null 2>&1; then
            _wv_unavailable_json "WV_DB not resolvable or causal identity tools unavailable"
            return 0
        fi
        if [[ -z "$weave_dir" || ! -d "$weave_dir" ]]; then
            _wv_unavailable_json "repository .weave directory not resolvable"
            return 0
        fi
        local rows components identity
        rows=$(_wv_identity_graph_rows) || {
            _wv_unavailable_json "causal identity query failed"
            return 0
        }
        components=$(
            printf '%s\n' "$_WV_CAUSAL_IDENTITY_FORMAT"
            printf 'graph_rows\t%s\n' "$rows"
            _wv_identity_file_line cutover_marker "$weave_dir/${WV_CUTOVER_MARKER_FILE:-causal-cutover}"
            _wv_identity_file_line cutover_authorization_manifest \
                "$weave_dir/${WV_CUTOVER_AUTHORIZATION_FILE:-cutover-authorization.json}"
            _wv_identity_delta_frontier_line "$weave_dir/deltas"
        ) || {
            _wv_unavailable_json "causal identity component read failed"
            return 0
        }
        identity=$(printf '%s\n' "$components" | sha256sum | awk '{print $1}')
        if [[ "$identity" =~ ^[a-f0-9]{64}$ ]]; then
            printf '{"kind":"composite_causal_identity","format":"%s","covers":["graph_rows","lineage","tombstones","cutover_marker","cutover_authorization_manifest","delta_catalog_frontier"],"value":"sha256:%s"}' \
                "$_WV_CAUSAL_IDENTITY_FORMAT" "$identity"
            return 0
        fi
        _wv_unavailable_json "causal identity hashing failed"
    }
    # An operation name is not a secret, but an unrecognized first argument might
    # be: it is whatever the user typed. The set of names that are NOT secret is
    # exactly the dispatch table, which the capability registry already declares
    # in full and pattern-audit already checks for totality -- so ask it, rather
    # than keep a fourth list that drifts. It drifted: cutover and repo-class were
    # dispatched for months and logged as <redacted:N> in every line, which is how
    # the E1 denominator lost two mutating commands.
    #
    # The four tokens below are not dispatch entries and never will be: they are
    # help and version flags handled before dispatch. They are named here because
    # a registry row would assert they are commands.
    _wv_normalized_operation() {
        local operation="${1:-help}"
        case "$operation" in
            help|--help|-h|version|--version|-v)
                printf '%s' "$operation"
                return 0
                ;;
        esac
        if _wv_cap_known "$operation" 2>/dev/null; then
            printf '%s' "$operation"
        else
            printf '<redacted:%s>' "$(_wv_byte_length "$operation")"
        fi
    }
    _wv_known_option() {
        case "$1" in
            --json|--json-v2|--all|--count|--findings|--canonical|--dry-run|--apply|--detail|--plan-file|--with-impact|--call-stats|--token-hogs|--trace-eval|--force|--quiet|--help|-h|--gh|--no-gh|--no-warn|--no-overlap-check|--skip-verification|--standalone|--code|--graph|--learning|--include-sync|--include-test|--status|--parent|--subtree|--text|--metadata|--metadata-file|--criteria|--risks|--learning-file|--verification-method|--verification-evidence|--verification-evidence-file|--intent|--files|--type|--limit|--mode|--source|--repo|--log|--usage-log|--call-log|--workflow-id|--trace-id|--topic|--procedure|--top|--since|--since-days|--host|--format|--order|--direction|--depth|--alias)
                return 0
                ;;
        esac
        return 1
    }
    _wv_option_consumes_value() {
        case "$1" in
            --status|--parent|--subtree|--text|--metadata|--metadata-file|--plan-file|--criteria|--risks|--learning-file|--verification-method|--verification-evidence|--verification-evidence-file|--intent|--files|--type|--limit|--mode|--source|--repo|--log|--usage-log|--call-log|--workflow-id|--trace-id|--topic|--procedure|--top|--since|--since-days|--host|--format|--order|--direction|--depth|--alias)
                return 0
                ;;
        esac
        return 1
    }
    _wv_nested_operation() {
        case "$1:$2" in
            analyze:sessions|analyze:suites|analyze:gates|config:enable|config:disable|config:get|config:set|hook:dispatch|quality:scan|quality:functions|quality:patterns|findings:promote|cache:clear|cache:stats)
                return 0
                ;;
        esac
        return 1
    }
    _wv_node_id_position() {
        case "$1:$2" in
            done:1|delete:1|work:1|show:1|update:1|touch:1|allowed-tools:1|ship:1|ship-agent:1|block:1|resolve:1|related:1|edges:1|tree:1|context:1|discover:1|preflight:1|validate-finding:1|link:1|link:2|unlink:1|unlink:2|path:1|path:2)
                return 0
                ;;
        esac
        if [ "$1" = "batch-done" ] && [ "$2" -ge 1 ]; then
            return 0
        fi
        return 1
    }
    _wv_argv_json() {
        local first=1 index=0 operation="${1:-help}" nested="${2:-}" redact_operand=0 id_operand=0 arg normalized option value
        printf '['
        for arg in "$@"; do
            [ "$first" -eq 1 ] || printf ','
            first=0
            if [ "$index" -eq 0 ]; then
                normalized=$(_wv_normalized_operation "$arg")
            elif [ "$redact_operand" -eq 1 ]; then
                if [ "$id_operand" -eq 1 ] && [[ "$arg" =~ ^wv-[a-f0-9]{4,6}$ ]]; then
                    normalized="$arg"
                else
                    normalized="<redacted:$(_wv_byte_length "$arg")>"
                fi
                redact_operand=0
                id_operand=0
            elif [ "$operation" = "config" ] && [ "$nested" = "set" ] && [ "$index" -gt 1 ]; then
                normalized="<redacted:$(_wv_byte_length "$arg")>"
            elif [[ "$arg" == --*=* ]]; then
                option="${arg%%=*}"
                value="${arg#*=}"
                if [[ "$option" =~ ^--(parent|subtree)$ ]] && [[ "$value" =~ ^wv-[a-f0-9]{4,6}$ ]]; then
                    normalized="${option}=${value}"
                elif _wv_known_option "$option"; then
                    normalized="${option}=<redacted:$(_wv_byte_length "$value")>"
                else
                    normalized="<redacted:$(_wv_byte_length "$arg")>"
                fi
            elif [ "$index" -eq 1 ] && _wv_nested_operation "$operation" "$arg"; then
                normalized="$arg"
            elif _wv_node_id_position "$operation" "$index" && [[ "$arg" =~ ^wv-[a-f0-9]{4,6}$ ]]; then
                normalized="$arg"
            elif _wv_known_option "$arg"; then
                normalized="$arg"
                if _wv_option_consumes_value "$arg"; then
                    redact_operand=1
                    [[ "$arg" =~ ^--(parent|subtree)$ ]] && id_operand=1
                fi
            else
                normalized="<redacted:$(_wv_byte_length "$arg")>"
            fi
            printf '"%s"' "$(_wv_json_escape "$normalized")"
            index=$((index + 1))
        done
        printf ']'
    }
    # Resolved classification, taken from the registry projection once. The
    # journal records what dispatch resolved rather than the command word, so no
    # reader re-derives a taxonomy: a second resolver is exactly the drift the
    # registry replaced.
    _wv_resolve_suboperation() {
        case "${2:-}" in
            ""|-*) return 0 ;;
        esac
        _wv_cap_refines "$1" "$2" && printf '%s' "$2"
        return 0
    }
    _wv_targets_json() {
        local targets target first=1
        targets=$(_wv_cap_targets "$1" "${2:-}" 2>/dev/null) || targets=""
        printf '['
        for target in $targets; do
            [ "$first" -eq 1 ] || printf ','
            first=0
            printf '"%s"' "$(_wv_json_escape "$target")"
        done
        printf ']'
    }

    # Provenance precedence: an explicit WV_CALL_SOURCE always wins (agent via
    # Claude Code settings.json, mcp via the MCP server, hook/sync/test via their
    # setters). Only when unset do we attest direct model origin for harnesses that
    # expose a host-guaranteed exec marker but no per-call env injection — Codex
    # (CODEX_THREAD_ID / CODEX_CI=1) and VS Code Copilot (COPILOT_AGENT=1). Those
    # markers are present only inside model-driven exec, never a human terminal, so
    # tagging agent here is honest attestation, not shell-as-agent. MCP children keep
    # mcp because the server sets WV_CALL_SOURCE=mcp, which this branch never reaches.
    # Marker set: Codex and Copilot only; Claude attests via explicit env. (It once
    # mirrored weave_gh _is_codex_runtime, removed when placement stopped reading
    # agent markers, wv-b831e3.) Contract: docs/TELEMETRY-SOURCE-CONTRACT.md
    _wv_source=$(_wv_resolve_call_source)
    # `wv hook` is the harness-neutral lifecycle-hook entry (Codex .codex/hooks.json,
    # and the Claude adapters as they move behind it). A host never tags it: Claude
    # hooks inherit WV_CALL_SOURCE=agent from settings.json and Codex hooks carry
    # CODEX_THREAD_ID, so both landed as agent traffic (wv-b2f8a8). Tag it here,
    # once for every host, and export so the wv calls it spawns inherit hook. A
    # test run keeps its tag.
    if [ "${1:-}" = "hook" ] && [ "$_wv_source" != "test" ]; then
        _wv_source="hook"
        export WV_CALL_SOURCE=hook
    fi
    _wv_repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)
    # BEFORE dispatch, and exported: a gate that runs inside the call needs an
    # identity to attach its verdict to, and one assigned after the command has
    # already run is not that.
    #
    # Exporting it means a wv launched underneath this one inherits it, and the
    # first version of this let the child adopt the parent's identity outright:
    # two call_started events under one call_id, and -- because the verdict
    # marker is keyed on that id and reset at both ends of every call -- a nested
    # call silently deleting the outer call's policy verdicts. wv quick alone
    # reaches that through its own pre-commit hook.
    #
    # WV_CALL_ID_OWNER is what separates the two cases an inherited variable
    # cannot distinguish on its own. A harness that pins WV_CALL_ID for a root
    # call sets no owner, so the id is honoured as given. A wv process stamps
    # itself as owner, so a descendant sees an owner that is not its own process
    # and mints a fresh identity, keeping the inherited one as parent_call_id.
    # Scoping the marker to the process instead would stop the deletion and
    # leave the duplicate identities, which is the half that corrupts counting.
    _wv_parent_call_id=""
    if [ -n "${WV_CALL_ID:-}" ] && [ -n "${WV_CALL_ID_OWNER:-}" ] && [ "$WV_CALL_ID_OWNER" != "$$" ]; then
        _wv_parent_call_id="$WV_CALL_ID"
        _wv_call_id=$(_wv_generate_call_id)
    else
        _wv_call_id="${WV_CALL_ID:-$(_wv_generate_call_id)}"
    fi
    export WV_CALL_ID="$_wv_call_id"
    export WV_CALL_ID_OWNER="$$"
    _wv_workflow_id="${WV_WORKFLOW_ID:-}"
    _wv_trace_id="${WV_TRACE_ID:-${_wv_workflow_id:-$_wv_call_id}}"
    _wv_operation=$(_wv_normalized_operation "${1:-help}")
    _wv_suboperation=$(_wv_resolve_suboperation "${1:-help}" "${2:-}")
    _wv_evidence_class=$(_wv_cap_evidence_class "${1:-help}" "$_wv_suboperation" 2>/dev/null) || _wv_evidence_class="unclassified"
    _wv_targets=$(_wv_targets_json "${1:-help}" "$_wv_suboperation")
    _wv_ts_start=$(date +%s%3N)
    _wv_ts_epoch=$(date +%s.%6N)
    _wv_argv=$(_wv_argv_json "$@")
    _wv_graph_before=$(_wv_causal_identity_json)

    # One context, set once: every event carries the same envelope because no call
    # site assembles one. wv_attempt_emit fails the call closed by itself under
    # evidence mode, so a caller cannot discard the failure.
    wv_attempt_context "$_wv_call_id" "$_wv_workflow_id" "$_wv_trace_id" "$_wv_source" \
        "$_wv_repo_root" "$_wv_operation" "$_wv_suboperation" "$_wv_evidence_class" \
        "$_wv_targets" "${WV_CAPABILITIES_IDENTITY:+sha256:$WV_CAPABILITIES_IDENTITY}" \
        "${WV_CAPABILITIES_SCHEMA:-}" "$_wv_graph_before" "$_wv_parent_call_id" \
        "${WV_POLICY_IDENTITY:+sha256:$WV_POLICY_IDENTITY}" "${WV_POLICY_SCHEMA:-}"
    # Claimed, not reset: a reset would silently adopt whatever another call
    # holding the same id had already recorded.
    wv_attempt_verdicts_claim || true

    # Durable before dispatch, so a call killed at any point after this leaves an
    # explicit incomplete attempt rather than silence.
    wv_attempt_emit call_started disposition=incomplete "argv:=$_wv_argv" || exit 1

    _wv_out=$(mktemp -t wv-calllog-XXXXXX)
    _wv_err=$(mktemp -t wv-calllog-err-XXXXXX)

    # Size-bounded rotation for the analytics log. Without it the file only ever
    # grows -- 401MB and 649k lines by 2026-09 on the first host to enable it,
    # with no rotation anywhere in the tree -- and every reader pays for the
    # whole history. One previous generation is kept, so the bound on disk is
    # twice WV_CALL_LOG_MAX_BYTES. Best-effort like the append it guards: a
    # failed rotation must never fail the command that triggered it, and two
    # racing rotations at worst discard one generation of analytics.
    _wv_rotate_call_log() {
        local max="${WV_CALL_LOG_MAX_BYTES:-67108864}"
        case "$max" in ''|*[!0-9]*) return 0 ;; esac
        [ "$max" -gt 0 ] || return 0
        local size
        size=$(stat -c %s "$WV_CALL_LOG" 2>/dev/null) || return 0
        [ "$size" -gt "$max" ] || return 0
        mv -f "$WV_CALL_LOG" "$WV_CALL_LOG.1" 2>/dev/null || return 0
    }

    # Everything after dispatch runs from an EXIT trap, not after `main` returns.
    # A command that calls exit directly -- wv config get on a missing key is one
    # -- never comes back to the caller, and before this the call simply vanished
    # from both surfaces: no completion event, no analytics row, and an attempt
    # that looked killed. The trap makes completion the property of the process
    # ending rather than of main being well behaved.
    _wv_finalize() {
        local rc=$?
        [ -n "${_WV_FINALIZED:-}" ] && return "$rc"
        _WV_FINALIZED=1
        _wv_exit="$rc"
        _wv_graph_after=$(_wv_causal_identity_json)
        _wv_ts_end=$(date +%s%3N)
        _wv_elapsed=$((_wv_ts_end - _wv_ts_start))
        _wv_stdout_bytes=$(wc -c < "$_wv_out" 2>/dev/null || echo 0)
        _wv_stderr_bytes=$(wc -c < "$_wv_err" 2>/dev/null || echo 0)
        rm -f "$_wv_out" "$_wv_err"

        # What a mutation-class call did to durable state, derived from the two
        # identities rather than declared. A failed call that moved the identity
        # anyway is the interesting case, and it is visible here instead of being
        # reported as simply failed.
        if [ "$_wv_evidence_class" = "mutation_attempt" ]; then
            if [ "$_wv_graph_before" = "$_wv_graph_after" ]; then
                _wv_disposition="unchanged"
            else
                _wv_disposition="changed"
            fi
            wv_attempt_emit mutation_disposition \
                "disposition=$_wv_disposition" "exit_status:=$_wv_exit" \
                "causal_identity_after:=$_wv_graph_after" || exit 1
        fi
        wv_attempt_emit call_completed disposition=complete \
            "exit_status:=$_wv_exit" "elapsed_ms:=$_wv_elapsed" \
            "causal_identity_after:=$_wv_graph_after" \
            "policy:=$(wv_attempt_policy_json)" || exit 1
        wv_attempt_verdicts_reset || true  # evidence mode exits inside; analytics swallows

        _wv_cmd="$_wv_operation"
        _wv_policy_revision=$(_wv_unavailable_json "no live host adapter emits an authoritative policy revision (wv-426134)")
        # Analytics stays opt-in and best-effort: the journal above is the surface
        # that fails closed, and coupling them would make enabling analytics change
        # evidence semantics.
        # parent_call_id is carried on both surfaces or on neither: an analytics
        # reader reconstructing a call tree from one and the journal from the
        # other would disagree about which calls had parents.
        _wv_parent_json="null"
        [ -n "${_wv_parent_call_id:-}" ] &&
            _wv_parent_json="\"$(_wv_json_escape "$_wv_parent_call_id")\""
        [[ -n "${WV_CALL_LOG:-}" ]] && _wv_rotate_call_log
        [[ -n "${WV_CALL_LOG:-}" ]] &&
        # Braced group: stderr is silenced before the >> open is attempted, so an
        # unwritable log path (read-only FS, missing dir) cannot leak bash errors.
        { printf '{"ts":%s,"cmd":"wv %s","stdout_bytes":%d,"stderr_bytes":%d,"elapsed_ms":%d,"source":"%s","call_id":"%s","parent_call_id":%s,"workflow_id":"%s","trace_id":"%s","repo_root":"%s","exit_status":%d,"argv":%s,"graph_identity_before":%s,"graph_identity_after":%s,"policy_revision":%s}\n' \
            "$_wv_ts_epoch" "$(_wv_json_escape "$_wv_cmd")" "$_wv_stdout_bytes" "$_wv_stderr_bytes" "$_wv_elapsed" "$(_wv_json_escape "$_wv_source")" "$(_wv_json_escape "$_wv_call_id")" "$_wv_parent_json" "$(_wv_json_escape "$_wv_workflow_id")" "$(_wv_json_escape "$_wv_trace_id")" "$(_wv_json_escape "$_wv_repo_root")" "$_wv_exit" "$_wv_argv" "$_wv_graph_before" "$_wv_graph_after" "$_wv_policy_revision" \
            >> "$WV_CALL_LOG"; } 2>/dev/null || true
        return "$rc"
    }
    trap '_wv_finalize' EXIT

    # errexit stays ON across dispatch. Disabling it here meant that on any
    # machine with WV_CALL_LOG set -- which config.env sets durably, so every
    # call on such a host -- main ran without abort-on-error, while the
    # untelemetered branch below ran with it. Enabling analytics silently
    # changed failure semantics: 37 of the 39 db_ensure call sites ignore their
    # return, so db_migrate_lineage's deliberate `return 1` (wv-db.sh:343) was
    # swallowed and execution continued past a failed durability migration.
    #
    # Nothing here needs errexit off to report a status. _wv_finalize takes
    # `local rc=$?` as its first statement, so when errexit aborts the shell the
    # trap still records main's real exit code; the assignment below is only
    # reached on success. main is already required to be errexit-clean by the
    # `else` branch, which has always run it that way.
    _wv_exit=0
    main "$@" > >( tee "$_wv_out" ) 2> >( tee "$_wv_err" >&2 )
    _wv_exit=$?
    exit "$_wv_exit"
else
    main "$@"
fi
