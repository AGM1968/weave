#!/usr/bin/env bash
# test-impacted.sh — fast, impact-scoped test runner for the Weave pre-commit gate.
#
# TEMPLATE: copy to <repo>/scripts/test-impacted.sh, edit the CONFIG block, and map
# sources to it in .weave/test-map.conf (glob/prefix supported since wv 1.60.0):
#     [map]
#     src/ = scripts/test-impacted.sh
#
# It inspects the STAGED source files and runs the test command on ONLY their
# mirror test directories under TEST_ROOT (climbing to the nearest existing
# ancestor), instead of the whole suite. A localized change runs in a fraction of
# the time; it falls back to the full suite when nothing resolves or when invoked
# with no staged sources. The test tree must mirror the source tree by DIRECTORY
# (filenames need not match — e.g. sampling/transect.py -> test_transect_sampler.py).
#
# The core assumes no language (wv-0ee3f4): declare RUNNER for yours. When the
# gate runs this suite frozen, the recipes in .weave/gate-provision.json provide
# its toolchain (PATH, VIRTUAL_ENV); ACTIVATE is only for manual runs and is
# skipped when the gate has provided an environment.
#
# Origin: a consumer test-bed (wv-f67f6f) — full unit suite 6.2s/1385
# tests -> ~1.1s for a single-directory change. Orthogonal to the test-map
# glob/prefix support (wv-d74631, mapping terseness) and impact suite selection
# (wv-7dd6a5): this scopes the runner WITHIN a selected suite.
# wv bash guard (wv-7257a8): bash >= 4 or a clear refusal. Identical in every executed entry point; master: scripts/lib/wv-bash-guard.sh.
_wv_bash_guard() {
    if [ -n "${WV_TEST_BASH_TOO_OLD:-}" ] && [ "${WV_TEST_MODE:-}" != 1 ]; then echo "wv: WV_TEST_BASH_TOO_OLD needs WV_TEST_MODE=1; ignoring it." >&2; fi
    if [ "${BASH_VERSINFO[0]:-0}" -ge 4 ] && ! { [ "${WV_TEST_MODE:-}" = 1 ] && [ "${WV_TEST_BASH_TOO_OLD:-}" = 1 ]; }; then
        unset WV_BASH_REEXEC
        return 0
    fi
    local b
    if [ -z "${WV_BASH_REEXEC:-}" ] && [ -f "$0" ]; then
        for b in ${WV_BASH:-} /opt/homebrew/bin/bash /usr/local/bin/bash /usr/bin/bash /bin/bash; do
            # shellcheck disable=SC2016  # the child bash expands it
            if [ -x "$b" ] && [ "$("$b" -c 'echo "${BASH_VERSINFO[0]}"' 2>/dev/null)" -ge 4 ] 2>/dev/null; then
                WV_BASH_REEXEC=1 WV_TEST_BASH_TOO_OLD='' exec "$b" "$0" "$@"
            fi
        done
    fi
    echo "wv: $0 needs bash 4 or newer but is running under bash ${BASH_VERSION:-unknown}." >&2
    echo "    On macOS /bin/bash is 3.2: install a newer one (brew install bash) or set WV_BASH to it." >&2
    exit 1
}
_wv_bash_guard "$@"
# end wv bash guard

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# ---- CONFIG (edit per repo) ------------------------------------------------
SRC_PREFIX="src/"                  # staged paths under here are impact-scoped
SRC_REGEX='^src/'                  # which staged files count as sources
TEST_ROOT="tests"                  # root of the mirror test tree
ACTIVATE=""                        # manual runs only, e.g. ".venv/bin/activate"
RUN_ENV=()                         # extra env, e.g. RUN_ENV=(DATABASE_URL="postgresql://...")
RUNNER=()                          # base test command, required; for example:
#   RUNNER=(python -m pytest)      RUNNER_ARGS=(-q --tb=short)   SRC_REGEX='^src/.*\.py$'
#   RUNNER=(npx vitest run)        RUNNER_ARGS=()                SRC_REGEX='^src/.*\.[jt]sx?$'
#   RUNNER=(cargo test --)         RUNNER_ARGS=()                SRC_REGEX='^src/.*\.rs$'
RUNNER_ARGS=()
# ---------------------------------------------------------------------------

if [ "${#RUNNER[@]}" -eq 0 ]; then
    echo "[impact] RUNNER is not set: declare this repository's test command in the CONFIG block of $0" >&2
    exit 2
fi
# shellcheck source=/dev/null
[ -z "${VIRTUAL_ENV:-}" ] && [ -n "$ACTIVATE" ] && [ -f "$ACTIVATE" ] && . "$ACTIVATE"

run_full() {
    echo "[impact] full suite (no localized target resolved)"
    exec env "${RUN_ENV[@]}" "${RUNNER[@]}" "$TEST_ROOT" "${RUNNER_ARGS[@]}"
}

# Staged sources (added/modified). Re-derived here so the script stands alone.
# --no-renames: a renamed-and-edited source is status R, which AM would drop.
mapfile -t staged < <(git diff --cached --name-only --no-renames --diff-filter=AM 2>/dev/null \
    | grep -E -- "$SRC_REGEX" || true)
[ "${#staged[@]}" -eq 0 ] && run_full

# Map each staged source to its mirror test dir, climbing to the nearest existing
# ancestor. A resolve to TEST_ROOT itself means "run the full suite".
declare -A targets
for f in "${staged[@]}"; do
    rel="${f#"$SRC_PREFIX"}"
    d="$TEST_ROOT/$(dirname "$rel")"
    while [ "$d" != "$TEST_ROOT" ] && [ "$d" != "$TEST_ROOT/." ] && [ ! -d "$d" ]; do
        d="$(dirname "$d")"
    done
    case "$d" in "$TEST_ROOT" | "$TEST_ROOT/.") run_full ;; esac
    targets["$d"]=1
done

sel=("${!targets[@]}")
echo "[impact] targets: ${sel[*]}"
exec env "${RUN_ENV[@]}" "${RUNNER[@]}" "${sel[@]}" "${RUNNER_ARGS[@]}"
