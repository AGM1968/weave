#!/usr/bin/env bash
: "${WV_BSD_SHIM_REAL:=${0%/*}/../real}"  # env -i drops the export; this stand-in sits in bin/ beside real/ (wv-43082a)
# BSD head stand-in (wv-418760): no negative counts.
prev=""
for a in "$@"; do
    case "$a" in -n-*|-c-*) echo "head: illegal line count -- ${a#-?}" >&2; exit 1 ;; esac
    if { [ "$prev" = -n ] || [ "$prev" = -c ]; } && [[ "$a" == -* ]]; then echo "head: illegal line count -- $a" >&2; exit 1; fi
    prev=$a
done
exec "$WV_BSD_SHIM_REAL/head" "$@"
